{
  "name": "@greener-games/vue-marzipano",
  "version": "0.0.0",
  "description": "Vue 3 wrapper for the Marzipano 360° panorama viewer, with scenes, hotspots and controls driven by a data object",
  "author": "",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "marzipano",
    "360",
    "panorama",
    "virtual-tour"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greener-Games/Vue-Marzipano.git",
    "directory": "plugins/@greener-games/vue-marzipano"
  },
  "homepage": "https://github.com/Greener-Games/Vue-Marzipano#readme",
  "bugs": {
    "url": "https://github.com/Greener-Games/Vue-Marzipano/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.2",
    "marzipano": "^0.10.2"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@types/node": "^25.9.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.22"
  }
}
